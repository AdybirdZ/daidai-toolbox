<resources>
    <style name="PrototypeTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#246BCE</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F4F6FA</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:buttonStyle">@style/FlatButton</item>
        <item name="android:alertDialogTheme">@style/FlatAlertDialog</item>
    </style>
    <style name="FlatButton" parent="android:style/Widget.Material.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
    </style>
    <style name="FlatDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
    </style>
    <style name="FlatAlertDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:buttonStyle">@style/FlatButton</item>
        <item name="android:buttonBarButtonStyle">@style/FlatDialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/FlatDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/FlatDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/FlatDialogButton</item>
    </style>
</resources>
